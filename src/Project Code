    // Min-Heap Dijkstra (Cross-Modal Route Extraction)
    void findOptimalRoute(string start, string end, int optimizationMode) {
        unordered_map<string, int> minWeight;
        unordered_map<string, string> parentStation; // Parent-pointer tracking
        unordered_map<string, string> parentMode;    // 紀錄父節點搭什麼車來的
        
        for (auto const& pair : adjacencyList) {
            minWeight[pair.first] = INF;
        }
        
        priority_queue<PQNode, vector<PQNode>, greater<PQNode>> minHeap;
        minWeight[start] = 0;
        minHeap.push(PQNode(start, 0, "START"));
        
        cout << "[開始導航] " << start << " -> " << end << "\n";
        cout << "演算法策略: ";
        if (optimizationMode == 0) cout << "最省時間 (Shortest Time)\n";
        else if (optimizationMode == 1) cout << "最少轉乘 (Minimum Transfers)\n";
        else if (optimizationMode == 2) cout << "最省錢 (Lowest Cost)\n";
        
        while (!minHeap.empty()) {
            PQNode current = minHeap.top();
            minHeap.pop();
            
            string u = current.stationName;
            if (u == end) break; // 提早結束
            if (current.currentWeight > minWeight[u]) continue; // Lazy deletion
            
            // 走訪相連的站點
            for (const Edge& edge : adjacencyList[u]) {
                string v = edge.destination;
                
                int evaluateWeight = 0;
                int nextMrtCount = 0; // 傳給下一個節點的捷運站數狀態
                
                // 最省錢模式區間計費邏輯
                if (optimizationMode == 2) {
                    if (edge.transitMode == "MRT") {
                        if (current.arrivedMode != "MRT") {
                            // 狀況 A：剛進站搭捷運 (收取基本費 20 元)
                            evaluateWeight = 20;
                            nextMrtCount = 1;
                        } else {
                            // 狀況 B：繼續搭捷運 (確認區間是否需要加錢)
                            nextMrtCount = current.mrtStationCount + 1;
                            
                            // 階梯計價：假設每多搭 3 站，票價加 5 元
                            if (nextMrtCount % 3 == 1) {
                                evaluateWeight = 5; // 跨區間，這條邊要加 5 元
                            } else {
                                evaluateWeight = 0; // 同區間內，這條邊免費 (0元)
                            }
                        }
                    } else {
                        // 如果不是捷運 (公車、YouBike)，直接讀取預設的 financialCost
                        evaluateWeight = edge.financialCost;
                        nextMrtCount = 0; // 離開捷運，站數歸零
                    }
                }
                // 最省時間 / 最少轉乘
                else {
                    evaluateWeight = edge.timeCost;
                    if (optimizationMode == 1 && current.arrivedMode != "START" && current.arrivedMode != edge.transitMode) {
                        evaluateWeight += TRANSFER_PENALTY;
                    }
                }
                
                // 更新權重並推入 Min-Heap
                int newWeight = minWeight[u] + evaluateWeight;
                if (newWeight < minWeight[v]) {
                    minWeight[v] = newWeight;
                    parentStation[v] = u;
                    parentMode[v] = edge.transitMode;
                    
                    // 把更新後的 nextMrtCount 傳遞給下一個節點
                    minHeap.push(PQNode(v, newWeight, edge.transitMode, nextMrtCount));
                }
            }
        }
        
        // 印出路徑 (升級版：路徑壓縮)
        if (minWeight[end] == INF) {
            cout << "找不到路線！\n";
            return;
        }

        // 1. 先把所有節點跟交通方式「反向」收集起來
        vector<string> routeNodes;
        vector<string> routeModes;
        string curr = end;
        while (curr != start) {
            routeNodes.push_back(curr);
            routeModes.push_back(parentMode[curr]);
            curr = parentStation[curr];
        }
        routeNodes.push_back(start); // 把起點也加進去
                
        // 2. 翻轉回正確順序 (起點 -> 終點)
        reverse(routeNodes.begin(), routeNodes.end());
        reverse(routeModes.begin(), routeModes.end());
        
        cout << "最佳路線：\n";
        string segmentStart = routeNodes[0];
        string currentMode = routeModes[0];
        
        // 3. 開始進行壓縮輸出
        for (size_t i = 1; i < routeNodes.size(); i++) {
            // 觸發輸出的條件：交通工具換了，或者是已經到了最後一站
            if (i == routeNodes.size() - 1 || routeModes[i] != currentMode) {
                cout << "   [" << segmentStart << "] --(" << currentMode << ")--> [" << routeNodes[i] << "]\n";
                // 更新下一段的起點與交通工具
                segmentStart = routeNodes[i];
                if (i < routeNodes.size() - 1) {
                    currentMode = routeModes[i];
                }
            }
        }
        cout << "（演算法計算總代價: " << minWeight[end] << (optimizationMode == 2 ? " 元）" : " 分鐘/懲罰分數）") << "\n";
        cout << "\n";
        cout << "====================================================\n";
    };


    // Synthetic Stress-Testing & Benchmarking
    void generateSyntheticGraph(int numStations, int numEdges) {
        cout << "[壓力測試] 正在生成大量虛擬路網 (節點: " << numStations << ", 路線: " << numEdges << ")...\n";
        adjacencyList.clear(); // 清空微縮宇宙

        for (int i = 0; i < numEdges; i++) {
            string src = "V_Station_" + to_string(rand() % numStations);
            string dest = "V_Station_" + to_string(rand() % numStations);
            if (src == dest) continue;
            
            int time = rand() % 30 + 1;
            int cost = rand() % 50 + 10;
            addRoute(src, dest, time, cost, "Virtual_Transit");
        }
    }

    // 對照組：使用 Unsorted Array 尋找最小節點的 Dijkstra
    void benchmarkArrayDijkstra(string start) {
        unordered_map<string, int> minWeight;
        unordered_map<string, bool> visited;
        for (auto const& pair : adjacencyList) {
            minWeight[pair.first] = INF;
            visited[pair.first] = false;
        }
        minWeight[start] = 0;

        auto startTime = high_resolution_clock::now(); // 計時開始

        // 進行 V 次線性尋找
        for (size_t i = 0; i < adjacencyList.size(); i++) {
            // O(V) 的尋找過程 (極度沒效率)
            string u = "";
            int minVal = INF;
            for (auto const& pair : minWeight) {
                if (!visited[pair.first] && pair.second < minVal) {
                    minVal = pair.second;
                    u = pair.first;
                }
            }

            if (u == "" || minVal == INF) break;
            visited[u] = true;

            for (const Edge& edge : adjacencyList[u]) {
                if (!visited[edge.destination] && minWeight[u] + edge.timeCost < minWeight[edge.destination]) {
                    minWeight[edge.destination] = minWeight[u] + edge.timeCost;
                }
            }
        }

        auto stopTime = high_resolution_clock::now(); // 計時結束
        auto duration = duration_cast<milliseconds>(stopTime - startTime);
        cout << "   [Unsorted Array - O(V^2)] 耗時: " << duration.count() << " 毫秒 (ms)\n";
    }

    // 實驗組：使用 Min-Heap 尋找最小節點的 Dijkstra
    void benchmarkMinHeapDijkstra(string start) {
        unordered_map<string, int> minWeight;
        for (auto const& pair : adjacencyList) minWeight[pair.first] = INF;

        priority_queue<PQNode, vector<PQNode>, greater<PQNode>> minHeap;
        minWeight[start] = 0;
        minHeap.push(PQNode(start, 0, "START"));

        auto startTime = high_resolution_clock::now(); // 計時開始

        while (!minHeap.empty()) {
            PQNode current = minHeap.top();
            minHeap.pop(); // O(log V) 瞬間拔出最小節點

            string u = current.stationName;
            if (current.currentWeight > minWeight[u]) continue;

            for (const Edge& edge : adjacencyList[u]) {
                if (minWeight[u] + edge.timeCost < minWeight[edge.destination]) {
                    minWeight[edge.destination] = minWeight[u] + edge.timeCost;
                    minHeap.push(PQNode(edge.destination, minWeight[edge.destination], edge.transitMode));
                }
            }
        }

        auto stopTime = high_resolution_clock::now(); // 計時結束
        auto duration = duration_cast<milliseconds>(stopTime - startTime);
        cout << "   [Min-Heap - O((V+E)logV)] 耗時: " << duration.count() << " 毫秒 (ms)\n";
    }
};

// 4. 主程式執行流 (完全依照 Proposal 的 4 點設計)
int main() {
    UrbanHiddenRouter engine;
    
    // [驗證 1] 靜態微縮路網建構
    engine.buildMicroUniverse();

    // [驗證 2-1] 最省時間導航：預期會瘋狂轉乘來爭取最快速度
    engine.findOptimalRoute("西門", "台大管院", 0);
    cout << "\n";

    // [驗證 2-2] 最少轉乘導航：預期會捨棄腳踏車，改搭一車到底但較慢的公車
    engine.findOptimalRoute("西門", "台大管院", 1);
    cout << "\n";

    // [驗證 2-3] 最省錢導航：預期會算出超便宜的票價！
    // 試試看沒有直達捷運的路線，看它怎麼幫妳省錢
    engine.findOptimalRoute("科技大樓", "公館", 2);
    cout << "\n";

    // ==========================================
    // 🚀 [驗證 4] 演算法效能標竿測試
    // ==========================================
    engine.generateSyntheticGraph(10000, 50000); // 1萬個節點，5萬條路線
    
    // 隨機抽一個節點當起點
    string startNode = "V_Station_0";
    
    engine.benchmarkArrayDijkstra(startNode);
    engine.benchmarkMinHeapDijkstra(startNode);
    cout << "\n";
    cout << "====================================================\n";

    return 0;
}
