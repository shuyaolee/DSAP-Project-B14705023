        addRoute("科技大樓", "六張犁", 2, 20, "MRT_文湖線");

        // 2. 微型節點與隱藏路網 (Walk / YouBike)
        addRoute("西門", "植物園", 5, 0, "Walk");
        addRoute("植物園", "建國中學", 2, 0, "Walk");
