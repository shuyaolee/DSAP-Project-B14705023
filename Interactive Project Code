// 系統常數設定
const int INF = numeric_limits<int>::max();
const int BLOCKED = 999999; // 路線阻斷時的極大代價 (避免 INF 溢位)
const int TRANSFER_PENALTY = 15;

// 1. 定義「邊」(Edge)
struct Edge {
    string destination;
    int timeCost;
    int financialCost;
    string transitMode;

    Edge(string dest, int time, int money, string mode)
        : destination(dest), timeCost(time), financialCost(money), transitMode(mode) {}
};

// 2. 狀態節點
struct PQNode {
    string stationName;
    int currentWeight;
    string arrivedMode;
    int mrtStationCount;

    PQNode(string name, int weight, string mode, int mrtCount = 0)
        : stationName(name), currentWeight(weight), arrivedMode(mode), mrtStationCount(mrtCount) {}

    bool operator>(const PQNode& other) const {
        return currentWeight > other.currentWeight;
    }
};

// 3. 核心導航引擎
class UrbanHiddenRouter {
private:
    unordered_map<string, vector<Edge>> adjacencyList;

public:
    void addRoute(string src, string dest, int time, int money, string mode) {
        adjacencyList[src].push_back(Edge(dest, time, money, mode));
        adjacencyList[dest].push_back(Edge(src, time, money, mode));
    }

    // 外部資料設定檔解析器 (File I/O)
    void loadGraphFromCSV(string filename) {
        ifstream file(filename);
        if (!file.is_open()) {
            cout << "WARNING: 找不到 " << filename << "，請確認檔案存在。系統將使用預設的微縮路網。\n";
            return;
        }

        string line, src, dest, time_str, money_str, mode;
        getline(file, line); // 跳過標題列
        
        while (getline(file, line)) {
            stringstream ss(line);
            getline(ss, src, ',');
            getline(ss, dest, ',');
            getline(ss, time_str, ',');
            getline(ss, money_str, ',');
            getline(ss, mode, ',');
            addRoute(src, dest, stoi(time_str), stoi(money_str), mode);
        }
        cout << "成功從 " << filename << " 載入外部路網資料！\n";
    }

    // 突發事件路網阻斷模擬
    void disruptEdge(string src, string dest) {
        cout << "[突發狀況] " << src << " 到 " << dest << " 的路線發生嚴重堵塞 / 停駛！\n";
        for (auto& edge : adjacencyList[src]) {
            if (edge.destination == dest) {
                edge.timeCost = BLOCKED;
                edge.financialCost = BLOCKED;
            }
        }
        for (auto& edge : adjacencyList[dest]) {
            if (edge.destination == src) {
                edge.timeCost = BLOCKED;
                edge.financialCost = BLOCKED;
            }
        }
    }

