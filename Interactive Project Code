    // 核心導航演算法 (包含所有動態權重與路徑壓縮)
    void findOptimalRoute(string start, string end, int optimizationMode) {
        unordered_map<string, int> minWeight;
        unordered_map<string, string> parentStation;
        unordered_map<string, string> parentMode;
        
        for (auto const& pair : adjacencyList) minWeight[pair.first] = INF;
        
        priority_queue<PQNode, vector<PQNode>, greater<PQNode>> minHeap;
        minWeight[start] = 0;
        minHeap.push(PQNode(start, 0, "START"));
        
        cout << "[開始導航] " << start << " -> " << end << "\n";
        cout << "演算法策略: ";
        if (optimizationMode == 0) cout << "最省時間 (Shortest Time)\n";
        else if (optimizationMode == 1) cout << "最少轉乘 (Minimum Transfers)\n";
        else if (optimizationMode == 2) cout << "最省錢 (Lowest Cost)\n";
        cout << "----------------------------------------------------\n";

        while (!minHeap.empty()) {
            PQNode current = minHeap.top();
            minHeap.pop();
            
            string u = current.stationName;
            if (u == end) break;
            if (current.currentWeight > minWeight[u]) continue;
            
            for (const Edge& edge : adjacencyList[u]) {
                string v = edge.destination;
                int evaluateWeight = 0;
                int nextMrtCount = 0;
                
                // 最省錢模式 (階梯計價)
                if (optimizationMode == 2) {
                    if (edge.transitMode.find("MRT") != string::npos) {
                        if (current.arrivedMode.find("MRT") == string::npos) {
                            evaluateWeight = 20;
                            nextMrtCount = 1;
                        } else {
                            nextMrtCount = current.mrtStationCount + 1;
                            evaluateWeight = (nextMrtCount % 3 == 1) ? 5 : 0;
                        }
                    } else {
                        evaluateWeight = edge.financialCost;
                        nextMrtCount = 0;
                    }
                }
                // 最省時間 / 最少轉乘
                else {
                    evaluateWeight = edge.timeCost;
                    if (optimizationMode == 1 && current.arrivedMode != "START" && current.arrivedMode != edge.transitMode) {
                        evaluateWeight += TRANSFER_PENALTY;
                    }
                }
                
                int newWeight = minWeight[u] + evaluateWeight;
                if (newWeight < minWeight[v]) {
                    minWeight[v] = newWeight;
                    parentStation[v] = u;
                    parentMode[v] = edge.transitMode;
                    minHeap.push(PQNode(v, newWeight, edge.transitMode, nextMrtCount));
                }
            }
        }
        
        // 輸出：路徑壓縮折疊機制
        if (minWeight[end] == INF || minWeight[end] >= BLOCKED) {
            cout << "找不到路線，目的地可能已被阻斷！\n\n";
            return;
        }
        
        vector<string> routeNodes, routeModes;
        string curr = end;
        while (curr != start) {
            routeNodes.push_back(curr);
            routeModes.push_back(parentMode[curr]);
            curr = parentStation[curr];
        }
        routeNodes.push_back(start);
        
        reverse(routeNodes.begin(), routeNodes.end());
        reverse(routeModes.begin(), routeModes.end());

        cout << "最佳路線：\n";
        string segmentStart = routeNodes[0];
        string currentMode = routeModes[0];

        for (size_t i = 1; i < routeNodes.size(); i++) {
            if (i == routeNodes.size() - 1 || routeModes[i] != currentMode) {
                cout << "   [" << segmentStart << "] --(" << currentMode << ")--> [" << routeNodes[i] << "]\n";
                segmentStart = routeNodes[i];
                if (i < routeNodes.size() - 1) currentMode = routeModes[i];
            }
        }
        cout << "（總代價: " << minWeight[end] << (optimizationMode == 2 ? " 元）\n\n" : " 分鐘/懲罰分數）\n\n");
    }

    // 自動化數據採集與匯出 CSV
    void generateSyntheticGraph(int numStations, int numEdges) {
        adjacencyList.clear();
        for (int i = 0; i < numEdges; i++) {
            string src = "V_" + to_string(rand() % numStations);
            string dest = "V_" + to_string(rand() % numStations);
            if (src != dest) addRoute(src, dest, rand() % 30 + 1, rand() % 50 + 10, "Virtual");
        }
    }

    long long benchmarkArray(string start) {
        unordered_map<string, int> minWeight;
        unordered_map<string, bool> visited;
        for (auto const& pair : adjacencyList) { minWeight[pair.first] = INF; visited[pair.first] = false; }
        minWeight[start] = 0;

        auto startTime = high_resolution_clock::now();
        for (size_t i = 0; i < adjacencyList.size(); i++) {
            string u = "";
            int minVal = INF;
            for (auto const& pair : minWeight) {
                if (!visited[pair.first] && pair.second < minVal) { minVal = pair.second; u = pair.first; }
            }
            if (u == "" || minVal == INF) break;
            visited[u] = true;
            for (const Edge& edge : adjacencyList[u]) {
                if (!visited[edge.destination] && minWeight[u] + edge.timeCost < minWeight[edge.destination]) {
                    minWeight[edge.destination] = minWeight[u] + edge.timeCost;
                }
            }
        }
        auto stopTime = high_resolution_clock::now();
        return duration_cast<milliseconds>(stopTime - startTime).count();
    }

    long long benchmarkHeap(string start) {
        unordered_map<string, int> minWeight;
        for (auto const& pair : adjacencyList) minWeight[pair.first] = INF;
        priority_queue<PQNode, vector<PQNode>, greater<PQNode>> minHeap;
        minWeight[start] = 0;
        minHeap.push(PQNode(start, 0, "START"));

        auto startTime = high_resolution_clock::now();
        while (!minHeap.empty()) {
            PQNode current = minHeap.top();
            minHeap.pop();
            string u = current.stationName;
            if (current.currentWeight > minWeight[u]) continue;
            for (const Edge& edge : adjacencyList[u]) {
                if (minWeight[u] + edge.timeCost < minWeight[edge.destination]) {
                    minWeight[edge.destination] = minWeight[u] + edge.timeCost;
                    minHeap.push(PQNode(edge.destination, minWeight[edge.destination], edge.transitMode));
                }
            }
        }
        auto stopTime = high_resolution_clock::now();
        return duration_cast<milliseconds>(stopTime - startTime).count();
    }

    void exportBenchmarkData(string filename) {
        ofstream file("/Users/leeshuyao/Desktop/" + filename);
        file << "Nodes,Edges,ArrayTime_ms,MinHeapTime_ms\n";
        cout << "\n【壓力測試】 開始執行多樣本數據採集，並匯出至 " << filename << "。\n";
        
        // 從 1000 點一路測到 15000 點 (考量電腦效能，間隔 2000)
        for (int nodes = 1000; nodes <= 15000; nodes += 2000) {
            int edges = nodes * 5;
            generateSyntheticGraph(nodes, edges);
            
            long long arrayTime = benchmarkArray("V_0");
            long long heapTime = benchmarkHeap("V_0");
            
            file << nodes << "," << edges << "," << arrayTime << "," << heapTime << "\n";
            cout << "   測試完成: " << nodes << " 節點 | Array: " << arrayTime << " ms | Heap: " << heapTime << " ms\n";
        }
        cout << "效能數據已成功匯出！\n====================================================\n";
    }
};

// 4. 互動式主程式執行流 (Interactive CLI)
int main() {
    UrbanHiddenRouter engine;
    cout << "\n====================================================\n";
    cout << "Welcome to Taipei Urban Hidden Router\n";
    cout << "====================================================\n";

    // 1. 詢問使用者是否要載入外部 CSV
    char useCSV;
    cout << "請問是否要載入外部 CSV 路網設定檔？(y/n): ";
    cin >> useCSV;

    if (useCSV == 'y' || useCSV == 'Y') {
        string filename;
        cout << "請輸入 CSV 檔案名稱 (包含副檔名，例如 routes.csv): ";
        cin >> filename;
        engine.loadGraphFromCSV(filename);
        // 如果載入失敗，為了確保系統能運作，還是載入預設路網
        engine.buildMicroUniverse();
    } else {
        cout << "使用系統內建台北交通路網\n";
        engine.buildMicroUniverse();
    }

    // 2. 啟動互動式主選單 (無窮迴圈，直到使用者選擇離開)
    while (true) {
        cout << "\n==================== MENU ====================\n";
        cout << " 1. 規劃導航路線 (可自訂起訖點與權重策略)\n";
        cout << " 2. 模擬突發路網阻斷 (動態改變路網狀態)\n";
        cout << " 3. 執行系統效能壓力測試 (匯出 CSV 報表)\n";
        cout << " 4. 離開系統\n";
        cout << "====================================================\n";
        
        int choice;
        cout << "請輸入執行選項 (1-4): ";
        cin >> choice;

        if (choice == 1) {
            string start, end;
            int mode;
            cout << "\n--- 路線規劃 ---\n";
            cout << "請輸入【起點】站名 (例如: 西門): ";
            cin >> start;
            cout << "請輸入【終點】站名 (例如: 台大管院): ";
            cin >> end;
            cout << "請選擇【導航策略】(0: 最省時間, 1: 最少轉乘次數, 2: 最省錢): ";
            cin >> mode;
            
            // 將使用者輸入的變數直接丟給寫好的引擎
            engine.findOptimalRoute(start, end, mode);
        }
        else if (choice == 2) {
            string src, dest;
            cout << "\n--- 路網阻斷模擬 ---\n";
            cout << "請輸入發生事故的【起點】站名: ";
            cin >> src;
            cout << "請輸入發生事故的【終點】站名: ";
            cin >> dest;
            engine.disruptEdge(src, dest);
            cout << "路網狀態已更新！您可以重新選擇 [1] 規劃路線來查看演算法如何繞路。\n";
        }
