            string filename;
            cout << "\n--- 效能壓力測試 ---\n";
            cout << "請輸入要匯出的檔名 (例如 report.csv): ";
            cin >> filename;
            engine.exportBenchmarkData(filename);
            
            // 跨平台打開資料夾魔法
            #ifdef _WIN32
                system("explorer .");
            #elif __APPLE__
                system("open .");
            #else
                cout << "請前往程式執行的目錄尋找檔案\n";
            #endif
        }
        else if (choice == 4) {
            cout << "\n感謝使用，系統關閉，再見！\n";
            break; // 打破迴圈，結束程式
        }
        else {
            cout << "無效的輸入，請重新選擇！\n";
        }
    }

    return 0;
}
